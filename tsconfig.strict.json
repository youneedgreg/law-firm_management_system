{
  // Staged strictness (ROADMAP Phase 0).
  //
  // These flags are not yet in tsconfig.json because turning them on today
  // surfaces 18 errors, 7 of them in `src/components/form.tsx` — a file under
  // active development. Run `npx tsc --noEmit -p tsconfig.strict.json` to see
  // the current count.
  //
  // When the forms work lands: fix the errors, move this "compilerOptions"
  // block into tsconfig.json, and delete this file.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true
  }
}
