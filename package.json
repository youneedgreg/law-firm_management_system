{
  "name": "law-firm_management_system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "verify": "npm run check:lockfile && npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:clean": "rm -rf .next node_modules && npm ci && npm run verify",
    "prepare": "husky",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/infra/sql/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local src/infra/seed/run.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@effect-rx/rx": {
      "@effect/platform": "$@effect/platform"
    },
    "@sveltejs/kit": {
      "@sveltejs/vite-plugin-svelte": "6.2.1"
    }
  },
  "dependencies": {
    "@better-auth/core": "^1.7.1",
    "@effect-rx/rx-react": "0.42.4",
    "@effect/opentelemetry": "0.64.0",
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.108.1",
    "@effect/sql": "0.52.1",
    "@effect/sql-pg": "0.53.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/instrumentation": "0.221.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@phosphor-icons/web": "^2.1.2",
    "@vercel/blob": "2.8.0",
    "@vercel/otel": "2.1.3",
    "better-auth": "^1.7.1",
    "effect": "3.22.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@effect/vitest": "0.30.0",
    "@electric-sql/pglite": "^0.5.5",
    "@playwright/test": "^1.62.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
}
